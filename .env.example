# Application Environment
ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite Persistence
DATABASE_URL=sqlite+aiosqlite:///./ai_java_engineer.db

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Backend Configuration
EXECUTION_BACKEND=mock # Options: mock, remote_ci
REMOTE_CI_ENDPOINT=https://ci.example.com/api/v1/jobs
REMOTE_CI_AUTH_TOKEN=
REMOTE_CI_TIMEOUT_SECONDS=600

# Execution Budgets (Guardrails)
MAX_TOTAL_TOKENS=250000
MAX_MODEL_CALLS=40
MAX_DEBUG_ITERATIONS=3
MAX_RUNTIME_SECONDS=1800
